# KINGTRUX API Configuration
# Copy this file to .env and fill in your API keys.
# All keys are passed to Flutter via --dart-define flags at build/run time.
# NEVER commit a file containing real API keys to version control.

# ── Google Maps ───────────────────────────────────────────────────────────────
# Get your key at: https://console.cloud.google.com/ → APIs & Services → Credentials
# Enable "Maps SDK for Android", "Maps SDK for iOS", and "Maps JavaScript API".
# Android key: injected into AndroidManifest.xml and passed via --dart-define.
GOOGLE_MAPS_ANDROID_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
# Web key: injected into web/index.html (restrict to your web origin).
GOOGLE_MAPS_WEB_API_KEY=YOUR_GOOGLE_MAPS_WEB_API_KEY_HERE

# ── HERE Routing ──────────────────────────────────────────────────────────────
# REST API v8 – used for truck route calculation.
# Get your key at: https://developer.here.com/
HERE_API_KEY=your_here_api_key_here

# HERE Navigate SDK credentials (native SDK – see HERE_NAVIGATE_SETUP.md)
# Obtain these from the HERE Developer Portal under your project's credentials.
HERE_NAVIGATE_ACCESS_KEY_ID=your_here_navigate_access_key_id_here
HERE_NAVIGATE_ACCESS_KEY_SECRET=your_here_navigate_access_key_secret_here

# ── OpenWeather ───────────────────────────────────────────────────────────────
# Get your key at: https://openweathermap.org/api (free tier available)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ── RevenueCat ────────────────────────────────────────────────────────────────
# Public SDK keys – safe to include in release builds, but NOT secrets.
# Create a project at https://app.revenuecat.com/
# iOS key: Project → Apple → Public SDK key (starts with appl_)
REVENUECAT_IOS_API_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Android key: Project → Google → Public SDK key (starts with goog_)
REVENUECAT_ANDROID_API_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Admin access ──────────────────────────────────────────────────────────────
# Comma-separated list of Firebase Auth email addresses with admin access.
# When empty, no user sees the Admin Area.
ADMIN_EMAILS=admin@example.com

# ── Usage ─────────────────────────────────────────────────────────────────────
# Pass all required keys via --dart-define at build/run time.  Example:
#
#   flutter run \
#     --dart-define=GOOGLE_MAPS_ANDROID_API_KEY=xxx \
#     --dart-define=HERE_API_KEY=yyy \
#     --dart-define=HERE_NAVIGATE_ACCESS_KEY_ID=zzz \
#     --dart-define=HERE_NAVIGATE_ACCESS_KEY_SECRET=www \
#     --dart-define=OPENWEATHER_API_KEY=aaa \
#     --dart-define=REVENUECAT_ANDROID_API_KEY=goog_xxx \
#     --dart-define=ADMIN_EMAILS=admin@example.com
#
# See README.md → "Configure API Keys" for full setup instructions including
# CI/GitHub Actions secrets configuration.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Scale reports: any authenticated user (including anonymous) may read
    // or write.  Unauthenticated users may read only.
    match /scale_reports/{scaleId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /reports/{reportId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // All other collections are denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
